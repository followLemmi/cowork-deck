{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cowork-deck",
  "version": "0.1.0",
  "identifier": "ca.jvl.coworkdeck",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run stage:reporter"
  },
  "app": {
    "windows": [
      { "title": "cowork-deck", "width": 1200, "height": 800, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/cowork_report"]
  }
}

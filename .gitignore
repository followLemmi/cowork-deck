target/
# No trailing slash: in a git worktree `node_modules` is a symlink to the main
# checkout's copy, and `node_modules/` matches a directory only — so every
# worktree reported the symlink as untracked.
node_modules
dist/
.DS_Store
src-tauri/gen/
src-tauri/binaries/

# superpowers SDD scratch (ledger, briefs, review packages)
.superpowers/

# Code-intelligence and MCP caches: per-machine, disposable, and large
# (.gitnexus is ~80 MB). The GitNexus instructions in CLAUDE.md are committed;
# the index they read is not.
.gitnexus/
.serena/
